#!/bin/bash
# The child-facing "ask a parent to install something" screen (tier maxi).
#
# The child account has no admin rights, so it cannot install anything itself.
# This asks the local agent to record a request; a parent sees it in the
# Control Center (with a desktop notification), approves or denies it, and
# installs an approved one with their admin account. Only packages from the
# official or Omarchy repositories can be requested — the agent refuses the
# rest (AUR, unknown names) and says why.
#
# Run from the Omarchy menu (Install), see tiers/maxi/menu/menu.sh; also
# usable directly as `omarchy-kids-request-install`.
set -u

pause() {
  echo
  read -rp "Press Enter to continue... " _
}

ask_for_program() {
  echo
  echo "Type the name of the program. Use its package name, for example: gimp"
  local package note
  package="$(gum input --placeholder 'package name' --prompt 'Program> ')" || return 0
  package="${package//[[:space:]]/}"
  [[ -n $package ]] || return 0
  note="$(gum input --placeholder 'Why do you want it? (optional)' --prompt 'Note> ')" || note=""
  echo
  # `--` so a name that starts with "-" can never be read as an option.
  if [[ -n $note ]]; then
    omarchy-kids-agent request-install --note "$note" -- "$package"
  else
    omarchy-kids-agent request-install -- "$package"
  fi
  pause
}

show_requests() {
  echo
  omarchy-kids-agent requests || echo "Could not reach the Kids agent."
  pause
}

while true; do
  choice="$(gum choose --header 'Ask a parent to install something' \
    'Ask for a program' 'See my requests' 'Close')" || exit 0
  case $choice in
    'Ask for a program') ask_for_program ;;
    'See my requests') show_requests ;;
    *) exit 0 ;;
  esac
done
