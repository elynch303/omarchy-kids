# Maintainer: Omarchy Kids
pkgname=omarchy-kids-agent
pkgver=0.1.0
pkgrel=1
pkgdesc="Omarchy Kids session daemon + CLI: tiers, app unlocks, time budgets, usage log (issue #14)"
arch=('x86_64' 'aarch64')
url="https://github.com/jfuerwentsches/omarchy-kids"
license=('MIT')
# The post_install/post_upgrade/post_remove scriptlet functions must live in
# this separate file: functions defined in the PKGBUILD itself are not
# packaged, so they silently never ran.
install=omarchy-kids-agent.install
depends=('polkit' 'sqlite' 'ufw' 'libnotify' 'openssh' 'sudo' 'git')
makedepends=('cargo' 'pkgconf')
optdepends=('gcompris-qt: mini tier default app'
            'blinken: mini tier default app'
            'tuxpaint: mini tier default app')
source=()
sha256sums=()

pkgver() {
  cd "$startdir/.."
  echo "$pkgver"
}

build() {
  cd "$startdir/.."

  # In makepkg's Arch Rust environment, rusqlite's bundled libsqlite3 can be
  # omitted from the final link (undefined sqlite3_* symbols). For the Arch
  # package, link against Arch's sqlite package explicitly instead.
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  cargo build --release --workspace
}

check() {
  cd "$startdir/.."
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  cargo test --release --workspace
}

package() {
  cd "$startdir/.."

  install -Dm755 target/release/omarchy-kids-agent "$pkgdir/usr/bin/omarchy-kids-agent"
  install -Dm755 target/release/omarchy-kids-agentd "$pkgdir/usr/bin/omarchy-kids-agentd"
  install -Dm755 target/release/omarchy-kids-run "$pkgdir/usr/bin/omarchy-kids-run"
  install -Dm755 target/release/omarchy-kids-pairing "$pkgdir/usr/bin/omarchy-kids-pairing"

  # Not in /usr/bin: only ever meant to be reached via the pkexec action
  # below (its path is baked into the policy's
  # org.freedesktop.policykit.exec.path annotation), never run directly.
  install -Dm755 target/release/omarchy-kids-override-helper \
    "$pkgdir/usr/lib/omarchy-kids/omarchy-kids-override-helper"
  install -Dm755 target/release/omarchy-kids-repair-helper \
    "$pkgdir/usr/lib/omarchy-kids/omarchy-kids-repair-helper"
  install -Dm755 target/release/omarchy-kids-install-helper \
    "$pkgdir/usr/lib/omarchy-kids/omarchy-kids-install-helper"

  install -Dm644 packaging/systemd/omarchy-kids-agentd.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-kids-agentd.service"

  install -Dm644 packaging/polkit/net.omarchykids.agent.policy \
    "$pkgdir/usr/share/polkit-1/actions/net.omarchykids.agent.policy"
}
